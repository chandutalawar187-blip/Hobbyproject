<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="LOQ Control"
           Manufacturer="LOQ Control"
           Version="1.2.2"
           UpgradeCode="{8E4E5B57-0B7F-4A58-9BA4-8DC0B9D45F14}"
           Scope="perMachine">
    <SummaryInformation Description="Native Lenovo LOQ fan control and telemetry." />
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of LOQ Control is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="LoqControlIcon" SourceFile="$(var.PublishDir)\app_icon.ico" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\LOQ-Control-License.rtf" />
    <WixVariable Id="WixUIDialogBmp"
                 Value="$(var.SourceDir)\LOQ-Control-Setup.bmp" />
    <WixVariable Id="WixUIBannerBmp"
                 Value="$(var.SourceDir)\LOQ-Control-Banner.bmp" />
    <Property Id="ARPPRODUCTICON" Value="LoqControlIcon" />
    <PropertyRef Id="WixShellExecTarget" />
    <Property Id="WixShellExecTarget" Value="[#LoqControlExe]" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch LOQ Control after installation" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="MainFeature" Title="LOQ Control" Level="1">
      <ComponentRef Id="ApplicationComponent" />
      <ComponentRef Id="HardwareServiceComponent" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentGroupRef Id="HardwareServiceFiles" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="LOQ Control">
        <Directory Id="AssetsFolder" Name="Assets">
          <Directory Id="AssetImagesFolder" Name="i" />
        </Directory>
        <Directory Id="ThirdPartyFolder" Name="ThirdParty">
          <Directory Id="LibreHardwareMonitorFolder" Name="LibreHardwareMonitor" />
        </Directory>
        <Directory Id="HardwareServiceFolder" Name="HardwareService" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="LOQ Control" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ApplicationComponent" Guid="*">
        <File Id="LoqControlExe"
              Source="$(var.PublishDir)\LoqControl.exe"
              KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\LOQ Control"
                       Name="InstallPath"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="no" />
        <RemoveFile Id="RemoveLegacyStartupLog"
                    Name="startup-error.log"
                    On="both" />
        <RemoveFile Id="RemoveLegacyRgbLog"
                    Name="rgb-hid.log"
                    On="both" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="HardwareServiceFolder">
      <Component Id="HardwareServiceComponent" Guid="*">
        <File Id="LoqControlHardwareServiceExe"
              Source="$(var.ServicePublishDir)\LenovoLoqControlService.exe"
              KeyPath="yes">
        </File>
        <ServiceInstall Id="LoqControlHardwareServiceInstall"
                        Name="LoqControlHardwareService"
                        DisplayName="LOQ Control Hardware Service"
                        Description="Provides verified elevated Lenovo LOQ hardware control and telemetry."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Type="ownProcess"
                        Vital="yes" />
        <ServiceControl Id="LoqControlHardwareServiceControl"
                        Name="LoqControlHardwareService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="LOQ Control"
                  Description="Lenovo LOQ control center"
                  Target="[INSTALLFOLDER]LoqControl.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="LoqControlIcon"
                  IconIndex="0"
                  Advertise="no" />
        <RegistryValue Root="HKCU"
                       Key="Software\LOQ Control"
                       Name="DesktopShortcutComponent"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuComponent" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="LOQ Control"
                  Description="Lenovo LOQ control center"
                  Target="[INSTALLFOLDER]LoqControl.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="LoqControlIcon"
                  IconIndex="0"
                  Advertise="no" />
        <RemoveFile Id="RemoveStartMenuFiles" Name="*" On="uninstall" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\LOQ Control"
                       Name="StartMenuComponent"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="LOQ Control"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]LoqControl.exe&quot; --startup" />
      </Component>
    </DirectoryRef>

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="Wix4ShellExec_X64"
               Condition="WixShellExecTarget AND NOT REMOVE AND NOT PATCH" />
    </UI>

  </Package>

  <Fragment>
    <CustomActionRef Id="Wix4ShellExec_X64" />
  </Fragment>
</Wix>
