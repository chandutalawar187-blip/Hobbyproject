<UserControl x:Class="LenovoLoqControl.UI.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LenovoLoqControl.UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
    <StackPanel ui:UiAnimation.StaggerChildrenOnLoad="True">
      <TextBlock Style="{StaticResource Text.BodySecondary}" Margin="0,0,0,16"
                 Text="Run explicit maintenance workflows without hiding hardware limitations or making unverified changes."/>
      <Border x:Name="ResultBanner" Style="{StaticResource Badge.Neutral}" Margin="0,0,0,16" Padding="14,8" Visibility="Collapsed">
        <TextBlock x:Name="ResultText" Style="{StaticResource Badge.Text}" TextWrapping="Wrap"/>
      </Border>
      <UniformGrid x:Name="WorkflowGrid" Columns="2"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
