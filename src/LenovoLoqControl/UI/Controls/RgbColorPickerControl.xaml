<UserControl x:Class="LenovoLoqControl.UI.Controls.RgbColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="292"
             MinHeight="360"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="RGB color picker">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Picker.Bg" Color="#12151C"/>
    <SolidColorBrush x:Key="Picker.Edge" Color="#2A3544"/>
    <SolidColorBrush x:Key="Picker.TabBg" Color="#181C24"/>
    <SolidColorBrush x:Key="Picker.TabActive" Color="#1A2834"/>
    <SolidColorBrush x:Key="Picker.Cyan" Color="#5EC8FF"/>
    <SolidColorBrush x:Key="Picker.Muted" Color="#7A8798"/>
    <SolidColorBrush x:Key="Picker.Text" Color="#E8EEF6"/>
    <SolidColorBrush x:Key="Picker.Field" Color="#0E1218"/>

    <Style x:Key="Picker.Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Picker.Muted}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Root"
                    Background="Transparent"
                    Padding="14,11"
                    BorderThickness="0,0,0,2"
                    BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Picker.TabActive}"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Picker.Cyan}"/>
                <Setter Property="Foreground" Value="{StaticResource Picker.Cyan}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Picker.Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Picker.HexField" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Picker.Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Picker.Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Picker.Cyan}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Picker.Edge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Picker.Cyan}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Picker.CircleButton" TargetType="Button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Width="36" Height="36"
                    Background="{StaticResource Picker.Field}"
                    BorderBrush="{StaticResource Picker.Edge}"
                    BorderThickness="1"
                    CornerRadius="18">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Picker.Cyan}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{StaticResource Picker.Bg}"
          BorderBrush="{StaticResource Picker.Edge}"
          BorderThickness="1"
          CornerRadius="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="{StaticResource Picker.TabBg}"
              CornerRadius="12,12,0,0"
              BorderBrush="{StaticResource Picker.Edge}"
              BorderThickness="0,0,0,1">
        <UniformGrid Columns="2">
          <RadioButton x:Name="TabSwatches"
                       GroupName="RgbPickerTabs"
                       Style="{StaticResource Picker.Tab}"
                       IsChecked="True"
                       Checked="TabChanged"
                       AutomationProperties.Name="Swatches tab">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="11" Height="11" Margin="0,0,8,0">
                <Canvas Width="16" Height="16">
                  <Rectangle Canvas.Left="1" Canvas.Top="1" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#5EC8FF"/>
                  <Rectangle Canvas.Left="9" Canvas.Top="1" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#5EC8FF"/>
                  <Rectangle Canvas.Left="1" Canvas.Top="9" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#5EC8FF"/>
                  <Rectangle Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#5EC8FF"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Swatches" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="TabPrecise"
                       GroupName="RgbPickerTabs"
                       Style="{StaticResource Picker.Tab}"
                       Checked="TabChanged"
                       AutomationProperties.Name="Precise tab">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="12" Height="12" Margin="0,0,8,0">
                <Canvas Width="16" Height="16">
                  <Line X1="2" Y1="4" X2="14" Y2="4" Stroke="#7A8798" StrokeThickness="1.6"/>
                  <Line X1="2" Y1="8" X2="14" Y2="8" Stroke="#7A8798" StrokeThickness="1.6"/>
                  <Line X1="2" Y1="12" X2="14" Y2="12" Stroke="#7A8798" StrokeThickness="1.6"/>
                  <Ellipse Canvas.Left="5" Canvas.Top="2.2" Width="3.6" Height="3.6" Fill="#7A8798"/>
                  <Ellipse Canvas.Left="9" Canvas.Top="6.2" Width="3.6" Height="3.6" Fill="#7A8798"/>
                  <Ellipse Canvas.Left="4" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="#7A8798"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Precise" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </UniformGrid>
      </Border>

      <Grid Grid.Row="1" Margin="14,14,14,8" MinHeight="220">
        <UniformGrid x:Name="SwatchGrid" Columns="8"/>

        <Grid x:Name="PrecisePanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border x:Name="SvHost"
                  CornerRadius="8"
                  BorderBrush="{StaticResource Picker.Edge}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  MinHeight="160"
                  Cursor="Cross"
                  MouseLeftButtonDown="SvPointerDown"
                  MouseMove="SvPointerMove"
                  MouseLeftButtonUp="SvPointerUp">
            <Grid>
              <Rectangle x:Name="SvHueBase"/>
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#FF000000" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Ellipse x:Name="SvCursor"
                       Width="14" Height="14"
                       Stroke="White" StrokeThickness="2"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6"/>
                </Ellipse.Effect>
              </Ellipse>
            </Grid>
          </Border>

          <Border x:Name="HueHost"
                  Grid.Row="1"
                  Height="16"
                  Margin="0,12,0,0"
                  CornerRadius="8"
                  BorderBrush="{StaticResource Picker.Edge}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  Cursor="Hand"
                  MouseLeftButtonDown="HuePointerDown"
                  MouseMove="HuePointerMove"
                  MouseLeftButtonUp="HuePointerUp">
            <Grid>
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFF0000" Offset="0"/>
                    <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                    <GradientStop Color="#FF00FF00" Offset="0.33"/>
                    <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                    <GradientStop Color="#FF0000FF" Offset="0.67"/>
                    <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                    <GradientStop Color="#FFFF0000" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Border x:Name="HueCursor"
                      Width="6" Height="16"
                      BorderBrush="White" BorderThickness="2"
                      Background="Transparent"
                      CornerRadius="2"
                      HorizontalAlignment="Left"
                      IsHitTestVisible="False"/>
            </Grid>
          </Border>

          <UniformGrid Grid.Row="2" Columns="3" Margin="0,16,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Text="R" Foreground="{StaticResource Picker.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
              <Slider x:Name="SliderR" Minimum="0" Maximum="255" Height="58" ValueChanged="ChannelSliderChanged"/>
            </StackPanel>
            <StackPanel Margin="3,0">
              <TextBlock Text="G" Foreground="{StaticResource Picker.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
              <Slider x:Name="SliderG" Minimum="0" Maximum="255" Height="58" ValueChanged="ChannelSliderChanged"/>
            </StackPanel>
            <StackPanel Margin="6,0,0,0">
              <TextBlock Text="B" Foreground="{StaticResource Picker.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
              <Slider x:Name="SliderB" Minimum="0" Maximum="255" Height="58" ValueChanged="ChannelSliderChanged"/>
            </StackPanel>
          </UniformGrid>
        </Grid>
      </Grid>

      <Border Grid.Row="2"
              Padding="14,10,14,14"
              BorderBrush="{StaticResource Picker.Edge}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Ellipse x:Name="SelectedPreview"
                   Width="36" Height="36"
                   Stroke="{StaticResource Picker.Edge}"
                   StrokeThickness="1"
                   Fill="#6F19E6"
                   ToolTip="Selected color"/>

          <Button x:Name="EyedropperButton"
                  Grid.Column="2"
                  Style="{StaticResource Picker.CircleButton}"
                  Click="EyedropperClick"
                  ToolTip="Pick a color from the screen"
                  AutomationProperties.Name="Eyedropper">
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path Stroke="#7A8798" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M4,16 L10,10 M9,9 L15,3 18,6 12,12 M11,13 L7,17 M6.5,14.5 L9.5,17.5"/>
              </Canvas>
            </Viewbox>
          </Button>

          <TextBox x:Name="HexText"
                   Grid.Column="4"
                   Style="{StaticResource Picker.HexField}"
                   Text="#6F19E6"
                   MaxLength="7"
                   TextChanged="HexTextChanged"
                   ToolTip="Color hex #RRGGBB"
                   AutomationProperties.Name="Color hex"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
