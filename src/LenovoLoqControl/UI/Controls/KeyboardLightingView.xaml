<UserControl x:Class="LenovoLoqControl.UI.Controls.KeyboardLightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LenovoLoqControl.UI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="280"
             d:DesignWidth="720"
             AutomationProperties.Name="Keyboard Lighting">
  <UserControl.Resources>
    <Style x:Key="Keyboard.LevelButton" TargetType="Button">
      <Setter Property="Background" Value="#12171F"/>
      <Setter Property="Foreground" Value="#9AA8BA"/>
      <Setter Property="BorderBrush" Value="#2A3340"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- This local style is parsed before application dictionaries are available. -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#1A212B"/>
                <Setter Property="Foreground" Value="#E8EEF6"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Keyboard.LevelButtonSelected" TargetType="Button" BasedOn="{StaticResource Keyboard.LevelButton}">
      <Setter Property="Background" Value="#2A1214"/>
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="BorderBrush" Value="#66E2231A"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <Grid>
                <Border Width="3"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="8,0,0,8"
                        Margin="-18,-12,0,-12"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border x:Name="RootCard" Style="{DynamicResource Card.Metric}" Margin="0,0,0,16" Padding="22,20">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock x:Name="TitleText"
                     Style="{DynamicResource Text.Subtitle}"
                     Text="Keyboard Lighting"/>
          <TextBlock x:Name="AvailabilityText"
                     Style="{DynamicResource Text.BodySecondary}"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     Text="Checking keyboard lighting…"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Border x:Name="TypeBadge" Style="{DynamicResource Badge.Mode}" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="TypeBadgeText"
                       Style="{DynamicResource Badge.Text}"
                       Text="Detecting…"/>
          </Border>
          <Button x:Name="RefreshButton"
                  Content="Refresh"
                  Style="{DynamicResource Button.Ghost}"
                  Padding="14,8"
                  Click="RefreshClick"
                  ToolTip="Re-read keyboard lighting status from the Lenovo provider"
                  AutomationProperties.Name="Refresh keyboard lighting"/>
        </StackPanel>
      </Grid>

      <!-- Keyboard silhouette (LOQ JIS reference) -->
      <controls:KeyboardLayoutVisual x:Name="KeyboardPreview"
                                     Margin="0,16,0,0"
                                     Visibility="Collapsed"/>

      <!-- White backlit controls -->
      <StackPanel x:Name="WhitePanel" Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock Style="{DynamicResource Text.Caption}"
                   Foreground="#6B7A8D"
                   Text="BRIGHTNESS"
                   Margin="0,0,0,10"/>
        <UniformGrid Columns="3" Margin="0,0,0,12">
          <Button x:Name="LevelOff"
                  Content="Off"
                  Style="{DynamicResource Keyboard.LevelButton}"
                  Margin="0,0,8,0"
                  Click="LevelOffClick"
                  AutomationProperties.Name="Keyboard lighting Off"
                  ToolTip="Turn keyboard backlight off"/>
          <Button x:Name="LevelLow"
                  Content="Low"
                  Style="{DynamicResource Keyboard.LevelButton}"
                  Margin="4,0"
                  Click="LevelLowClick"
                  AutomationProperties.Name="Keyboard lighting Low"
                  ToolTip="Set keyboard backlight to low"/>
          <Button x:Name="LevelHigh"
                  Content="High"
                  Style="{DynamicResource Keyboard.LevelButton}"
                  Margin="8,0,0,0"
                  Click="LevelHighClick"
                  AutomationProperties.Name="Keyboard lighting High"
                  ToolTip="Set keyboard backlight to high"/>
        </UniformGrid>
        <TextBlock x:Name="CurrentLevelText"
                   Style="{DynamicResource Text.BodySecondary}"
                   Text="Current level · Unknown"/>
      </StackPanel>

      <!-- Verified 4-zone RGB controls -->
      <Border x:Name="RgbInfoPanel"
              Style="{DynamicResource Card.Compact}"
              Margin="0,18,0,0"
              Padding="16"
              Visibility="Collapsed"
              IsHitTestVisible="True">
        <StackPanel>
          <TextBlock x:Name="RgbHeadline"
                     Style="{DynamicResource Text.Subtitle}"
                     FontSize="15"
                     Text="RGB keyboard detected"/>
          <TextBlock x:Name="RgbDetail"
                     Style="{DynamicResource Text.BodySecondary}"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     Text="RGB controls are available for this verified keyboard."/>
          <TextBlock x:Name="RgbInfoBody"
                     Style="{DynamicResource Text.Caption}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Foreground="#6B7A8D"
                     Text=""/>
          <StackPanel x:Name="RgbEffectPanel" Margin="0,14,0,0">
            <TextBlock Style="{DynamicResource Text.Caption}" Text="EFFECT"/>
            <ComboBox x:Name="RgbEffectCombo" SelectedValuePath="Tag" SelectedValue="Static"
                      SelectionChanged="RgbPreviewChanged" Margin="0,6,0,10">
              <ComboBoxItem Tag="Off" Content="Off"/>
              <ComboBoxItem Tag="Static" Content="Static"/>
              <ComboBoxItem Tag="Breathing" Content="Breathing"/>
              <ComboBoxItem Tag="ColorCycle" Content="Color Cycle"/>
              <ComboBoxItem Tag="Wave" Content="Wave"/>
            </ComboBox>
            <TextBlock Style="{DynamicResource Text.Caption}" Text="COLOR (#RRGGBB)"/>
            <TextBox x:Name="RgbColorText" Text="#FFFFFF" Margin="0,6,0,10" MaxLength="7"
                     TextChanged="RgbPreviewChanged"/>
            <TextBlock Style="{DynamicResource Text.Caption}" Text="SPEED"/>
            <Slider x:Name="RgbSpeedSlider" Minimum="0" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"
                    Margin="0,4,0,10" ValueChanged="RgbPreviewChanged"/>
            <TextBlock Style="{DynamicResource Text.Caption}" Text="Selecting an effect previews it on the keyboard. Apply to keep it." Margin="0,0,0,10"/>
            <Button x:Name="RgbApplyButton" Content="Apply RGB Effect" Style="{DynamicResource Button.Primary}" Click="ApplyRgbClick"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Unsupported -->
      <Border x:Name="UnsupportedPanel"
              Style="{DynamicResource Card.Unavailable}"
              Margin="0,18,0,0"
              Padding="16"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{DynamicResource Text.Subtitle}"
                     FontSize="15"
                     Text="Keyboard lighting unavailable"/>
          <TextBlock x:Name="UnsupportedDetail"
                     Style="{DynamicResource Text.BodySecondary}"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     Text=""/>
        </StackPanel>
      </Border>

      <Border x:Name="StatusBanner"
              Style="{DynamicResource Badge.Neutral}"
              Margin="0,16,0,0"
              Padding="14,8">
        <TextBlock x:Name="StatusText"
                   Style="{DynamicResource Badge.Text}"
                   TextWrapping="Wrap"
                   Text="Ready."/>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
