<UserControl x:Class="LenovoLoqControl.UI.FanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LenovoLoqControl.UI.Controls"
             xmlns:ui="clr-namespace:LenovoLoqControl.UI">
  <UserControl.Resources>
    <Style x:Key="Fan.MonitorPanel" TargetType="Border">
      <Setter Property="Background" Value="#0B0D10"/>
      <Setter Property="BorderBrush" Value="#2A3340"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>
    <Style x:Key="Fan.ModeStrip" TargetType="Border">
      <Setter Property="Background" Value="#10151D"/>
      <Setter Property="BorderBrush" Value="#2A3340"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>
    <Style x:Key="Fan.ModeButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#6B7A8D"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,14"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border x:Name="Accent"
                        Width="3"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Margin="-12, -14, 0, -14"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#161C24"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fan.ModeButtonSelectedQuiet" TargetType="Button" BasedOn="{StaticResource Fan.ModeButton}">
      <Setter Property="Background" Value="#152535"/>
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="#6640A9FF" BorderThickness="1" CornerRadius="2">
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" Background="#40A9FF" Margin="-12,-14,0,-14"/>
                <Border Background="#1840A9FF" Margin="-12,-14,-12,-14" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fan.ModeButtonSelectedBalance" TargetType="Button" BasedOn="{StaticResource Fan.ModeButton}">
      <Setter Property="Background" Value="#222830"/>
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="#55F0F4FA" BorderThickness="1" CornerRadius="2">
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" Background="#F0F4FA" Margin="-12,-14,0,-14"/>
                <Border Background="#18F0F4FA" Margin="-12,-14,-12,-14" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fan.ModeButtonSelectedPerformance" TargetType="Button" BasedOn="{StaticResource Fan.ModeButton}">
      <Setter Property="Background" Value="#2A1214"/>
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="#66E2231A" BorderThickness="1" CornerRadius="2">
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" Background="#E2231A" Margin="-12,-14,0,-14"/>
                <Border Background="#18E2231A" Margin="-12,-14,-12,-14" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fan.ModeButtonSelectedMaxCooling" TargetType="Button" BasedOn="{StaticResource Fan.ModeButton}">
      <Setter Property="Background" Value="#0D2228"/>
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="#6600E5FF" BorderThickness="1" CornerRadius="2">
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" Background="#00E5FF" Margin="-12,-14,0,-14"/>
                <Border Background="#1800E5FF" Margin="-12,-14,-12,-14" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fan.ModeButtonSelectedCustom" TargetType="Button" BasedOn="{StaticResource Fan.ModeButton}">
      <Setter Property="Background" Value="#221530"/>
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="#66B24BF3" BorderThickness="1" CornerRadius="2">
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" Background="#B24BF3" Margin="-12,-14,0,-14"/>
                <Border Background="#18B24BF3" Margin="-12,-14,-12,-14" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <Grid ui:UiAnimation.StaggerChildrenOnLoad="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="CapabilityBanner" Grid.Row="0" Style="{StaticResource Card.Warning}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock x:Name="CapabilityTitle" Style="{StaticResource Text.Subtitle}" Text="Checking fan control…"/>
          <TextBlock x:Name="CapabilityDetail" Style="{StaticResource Text.BodySecondary}" Margin="0,6,0,0" Text="…"/>
        </StackPanel>
      </Border>

      <!-- Exact ui.png control panel: CPU | RAM | GPU + mode strip -->
      <Border Grid.Row="1" Style="{StaticResource Fan.MonitorPanel}" Margin="0,0,0,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Caption}"
                       Foreground="#6B7A8D"
                       Text="LIVE TELEMETRY"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="LastUpdatedText"
                       Grid.Column="1"
                       Style="{StaticResource Text.Caption}"
                       Text="Waiting…"/>
          </Grid>

          <Grid x:Name="TelemetryModules" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:HexMetricModule x:Name="CpuModule"
                                      Grid.Column="0"
                                      Title="CPU"
                                      ShowFanRow="True"/>
            <controls:HexMetricModule x:Name="RamModule"
                                      Grid.Column="2"
                                      Title="RAM"
                                      ShowFanRow="False"/>
            <controls:HexMetricModule x:Name="GpuModule"
                                      Grid.Column="4"
                                      Title="GPU"
                                      ShowFanRow="True"/>
          </Grid>

          <Border Style="{StaticResource Fan.ModeStrip}">
            <Grid x:Name="ModePanel">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Button x:Name="ModeSilent" Grid.Column="0" Style="{StaticResource Fan.ModeButton}"
                      Content="Quiet" Click="ModeSilentClick"
                      ToolTip="Quiet fan behavior through firmware"/>
              <Rectangle Grid.Column="1" Width="1" Fill="#2A3340" Margin="0,8"/>
              <Button x:Name="ModeAuto" Grid.Column="2" Style="{StaticResource Fan.ModeButton}"
                      Content="Balance" Click="ModeAutoClick"
                      ToolTip="Firmware automatic thermal mode"/>
              <Rectangle Grid.Column="3" Width="1" Fill="#2A3340" Margin="0,8"/>
              <Button x:Name="ModePerformance" Grid.Column="4" Style="{StaticResource Fan.ModeButton}"
                      Content="Performance" Click="ModePerformanceClick"
                      ToolTip="Higher performance mode; may require AC power"/>
              <Rectangle Grid.Column="5" Width="1" Fill="#2A3340" Margin="0,8"/>
              <Button x:Name="ModeMaxCooling" Grid.Column="6" Style="{StaticResource Fan.ModeButton}"
                      Content="Max Cooling" Click="ModeMaxCoolingClick"
                      ToolTip="Run the Custom firmware profile at full speed; may require AC power"/>
              <Rectangle Grid.Column="7" Width="1" Fill="#2A3340" Margin="0,8"/>
              <Button x:Name="ModeCustom" Grid.Column="8" Style="{StaticResource Fan.ModeButton}"
                      IsEnabled="False" Click="ModeCustomClick"
                      ToolTip="Enabled when a firmware fan table can be applied">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Custom" VerticalAlignment="Center"/>
                  <Path Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="M9.1,2.1 L10.3,4.5 12.9,4.9 10.9,6.8 11.4,9.4 9.1,8.2 6.8,9.4 7.3,6.8 5.3,4.9 7.9,4.5 Z M4,11 H14 V13 H4 Z"/>
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <Border x:Name="ResultBanner" Style="{StaticResource Badge.Neutral}" Margin="0,12,0,0" Padding="14,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource Badge.Text}" TextWrapping="Wrap"
                       Text="Ready. No command has been sent yet."/>
          </Border>
        </StackPanel>
      </Border>

      <controls:KeyboardLightingView x:Name="KeyboardLighting"
                                     Grid.Row="2"/>

      <Border Grid.Row="3" Style="{StaticResource Panel.Section}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Subtitle}" Text="Fixed fan speed"/>
          <TextBlock Style="{StaticResource Text.BodySecondary}" Margin="0,6,0,12" TextWrapping="Wrap"
                     Text="Apply one firmware fan step (1 lowest → 10 highest) across normal temperature points. Safety overrides: at 85–94°C at least 60% cooling; at 95°C and above 100%."/>
          <StackPanel x:Name="FixedSpeedPanel"/>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                     Text="Step 1 = lowest firmware duty · Step 10 = highest firmware duty"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Style="{StaticResource Panel.Section}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Subtitle}" Text="Custom fan curve"/>
          <TextBlock Style="{StaticResource Text.BodySecondary}" Margin="0,6,0,14" TextWrapping="Wrap"
                     Text="Firmware defines the temperature points on the X-axis. Drag control points vertically to set fan percentage. Curves are validated before apply."/>
          <StackPanel x:Name="CurvePanel"/>
          <Border Style="{StaticResource Card.Compact}" Margin="0,12,0,0" Padding="14">
            <StackPanel>
              <CheckBox x:Name="ExtremeModeToggle"
                        Content="Enable Extreme Mode"
                        FontWeight="SemiBold"
                        Click="ExtremeModeClick"
                        ToolTip="Use Custom firmware mode with the verified full-speed cooling override."/>
              <TextBlock Style="{StaticResource Text.BodySecondary}"
                         Margin="24,5,0,0"
                         TextWrapping="Wrap"
                         Text="Runs the Custom firmware mode at maximum fan speed. AC power is required; temperature and fan noise may increase."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card.Compact}" Margin="0,12,0,0" Padding="14">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Subtitle}" Text="GPU overclock"/>
              <TextBlock x:Name="GpuOverclockStatus" Style="{StaticResource Text.BodySecondary}" Margin="0,5,0,10"
                         Text="Checking NVIDIA support…"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Core +" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="GpuCoreOffset" Grid.Column="1" Text="150" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="VRAM +" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="GpuMemoryOffset" Grid.Column="3" Text="200" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                  <Button Content="Apply" Click="ApplyGpuOverclockClick" Margin="0,0,8,0"/>
                  <Button Content="Reset" Click="ResetGpuOverclockClick"/>
                </StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                         Text="Offsets are limited to +150 MHz core and +200 MHz VRAM. AC power is required."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
