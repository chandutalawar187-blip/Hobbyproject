<Window x:Class="LenovoLoqControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:LenovoLoqControl.UI.Shell"
        xmlns:windowChrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LOQ Control"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{StaticResource Brush.BackgroundGradient}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SizeChanged="WindowSizeChanged">
  <WindowChrome.WindowChrome>
    <windowChrome:WindowChrome CaptionHeight="0"
                               GlassFrameThickness="0"
                               ResizeBorderThickness="6"
                               UseAeroCaptionButtons="True"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="TitleBar"
            Grid.Row="0"
            Background="{DynamicResource Brush.Navigation}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="0,0,0,1"
            PreviewMouseLeftButtonDown="TitleBarMouseDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="46"/>
          <ColumnDefinition Width="46"/>
          <ColumnDefinition Width="46"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="18,0,0,0"
                    VerticalAlignment="Center">
          <Border Width="24"
                  Height="24"
                  Padding="4"
                  Background="#FFFFFFFF"
                  CornerRadius="6"
                  VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/app_icon_black.png"
                   Stretch="Uniform"/>
          </Border>
          <TextBlock Text="LOQ Control"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0"/>
          <TextBlock Text="CONTROL CENTER"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     FontSize="9"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="10,2,0,0"/>
        </StackPanel>
        <Button x:Name="MinimizeButton"
                Grid.Column="1"
                ToolTip="Minimize"
                PreviewMouseLeftButtonDown="MinimizeWindowMouseDown"
                Style="{StaticResource WindowCaptionButton}">
          <Image Source="pack://application:,,,/Assets/caption_minimize.png"
                 Width="16"
                 Height="16"
                 Stretch="Uniform"/>
        </Button>
        <Button x:Name="MaximizeButton"
                Grid.Column="2"
                ToolTip="Maximize"
                PreviewMouseLeftButtonDown="MaximizeWindowMouseDown"
                Style="{StaticResource WindowCaptionButton}">
          <Grid x:Name="MaximizeIconHost"
                Width="16"
                Height="16"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform/>
            </Grid.RenderTransform>
            <Image x:Name="MaximizeIcon"
                   Source="pack://application:,,,/Assets/caption_maximize.png"
                   Stretch="Uniform"/>
            <Image x:Name="RestoreIcon"
                   Source="pack://application:,,,/Assets/caption_restore.png"
                   Stretch="Uniform"
                   Visibility="Collapsed"/>
          </Grid>
        </Button>
        <Button Grid.Column="3"
                ToolTip="Close"
                PreviewMouseLeftButtonDown="CloseWindowMouseDown"
                Style="{StaticResource WindowCloseButton}">
          <Image Source="pack://application:,,,/Assets/caption_close.png"
                 Width="16"
                 Height="16"
                 Stretch="Uniform"/>
        </Button>
      </Grid>
    </Border>
    <Grid x:Name="ShellRoot" Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="220" MinWidth="108" MaxWidth="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navigation rail -->
    <Border x:Name="NavRail" Grid.Column="0" Style="{StaticResource Navigation.Rail}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toggle + brand (fixed) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="NavToggleButton"
                  Style="{StaticResource Navigation.Hamburger}"
                  Click="NavToggleClick"
                  ToolTip="Collapse or expand navigation"
                  AutomationProperties.Name="Toggle navigation"
                  Visibility="Visible">
            <StackPanel x:Name="HamburgerGlyph" Width="18" VerticalAlignment="Center">
              <Border Height="2" CornerRadius="1" Background="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4"/>
              <Border Height="2" CornerRadius="1" Background="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4"/>
              <Border Height="2" CornerRadius="1" Background="{DynamicResource Brush.TextPrimary}"/>
            </StackPanel>
          </Button>
          <StackPanel x:Name="BrandPanel" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Navigation.BrandLabel}" Text="LOQ" FontSize="28"/>
            <TextBlock x:Name="BrandSubLabel"
                       Style="{StaticResource Navigation.BrandSubLabel}"
                       Text="CONTROL CENTER"
                       Margin="2,0,0,0"/>
          </StackPanel>
        </Grid>

        <!-- Scrollable identity + nav + health (needed when window height is short) -->
        <ScrollViewer x:Name="NavScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False">
          <StackPanel>
            <!-- Identity -->
            <Border x:Name="IdentityCard" Style="{StaticResource Shell.IdentityCard}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Text="SYSTEM"/>
                <TextBlock x:Name="ModelNameText"
                           Text="Reading model…"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,6,0,2"/>
                <TextBlock x:Name="MachineTypeText"
                           Style="{StaticResource Text.BodySecondary}"
                           FontSize="12"
                           Text="Machine type unavailable"/>
                <Border Style="{StaticResource Badge.Mode}" Margin="0,12,0,0">
                  <TextBlock x:Name="PerformanceModeBadge"
                             Style="{StaticResource Badge.Text}"
                             Text="Mode not reported"/>
                </Border>
              </StackPanel>
            </Border>

            <!-- Nav buttons -->
            <StackPanel x:Name="NavButtonPanel" Margin="0,8,0,0">
              <Button x:Name="NavDashboard"
                      Style="{StaticResource NavigationButton}"
                      Tag="Selected"
                      Click="DashboardClick"
                      ToolTip="System overview and live telemetry"
                      AutomationProperties.Name="Dashboard"
                      AutomationProperties.HelpText="System overview and live telemetry">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Image x:Name="NavDashboardIcon"
                         Source="pack://application:,,,/Assets/nav_dashboard.png"
                         Width="30"
                         Height="30"
                         Stretch="Uniform"
                         Margin="0,0,10,0"
                         AutomationProperties.Name="Dashboard icon"/>
                  <TextBlock x:Name="NavDashboardLabel" Text="Dashboard" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button x:Name="NavFan"
                      Style="{StaticResource NavigationButton}"
                      Click="FanClick"
                      ToolTip="Firmware fan modes, fixed speed, and curves"
                      AutomationProperties.Name="Fan Control">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Image x:Name="NavFanIcon"
                         Source="pack://application:,,,/Assets/nav_fan.png"
                         Width="30"
                         Height="30"
                         Stretch="Uniform"
                         Margin="0,0,10,0"
                         AutomationProperties.Name="Fan Control icon"/>
                  <TextBlock x:Name="NavFanLabel" Text="Fan Control" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button x:Name="NavLighting"
                      Style="{StaticResource NavigationButton}"
                      Click="LightingClick"
                      ToolTip="Keyboard backlight and RGB effects"
                      AutomationProperties.Name="Lighting">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Image x:Name="NavLightingIcon"
                         Source="pack://application:,,,/Assets/nav_lighting.png"
                         Width="30"
                         Height="30"
                         Stretch="Uniform"
                         Margin="0,0,10,0"
                         AutomationProperties.Name="Lighting icon"/>
                  <TextBlock x:Name="NavLightingLabel" Text="Lighting" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button x:Name="NavProfiles"
                      Style="{StaticResource NavigationButton}"
                      Click="ProfilesClick"
                      ToolTip="Quiet, Balanced, Performance, and Custom intents"
                      AutomationProperties.Name="Profiles">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Image x:Name="NavProfilesIcon"
                         Source="pack://application:,,,/Assets/nav_profiles.png"
                         Width="30"
                         Height="30"
                         Stretch="Uniform"
                         Margin="0,0,10,0"
                         AutomationProperties.Name="Profiles icon"/>
                  <TextBlock x:Name="NavProfilesLabel" Text="Profiles" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button x:Name="NavProjects"
                      Style="{StaticResource NavigationButton}"
                      Click="ProjectsClick"
                      ToolTip="Project workflows and maintenance actions"
                      AutomationProperties.Name="Projects">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Image x:Name="NavProjectsIcon"
                         Source="pack://application:,,,/Assets/nav_projects.png"
                         Width="30"
                         Height="30"
                         Stretch="Uniform"
                         Margin="0,0,10,0"
                         AutomationProperties.Name="Projects icon"/>
                  <TextBlock x:Name="NavProjectsLabel"
                             Text="Projects"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button x:Name="NavDiagnostics"
                      Style="{StaticResource NavigationButton}"
                      Click="DiagnosticsClick"
                      ToolTip="Compatibility and capability report"
                      AutomationProperties.Name="Diagnostics">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Image x:Name="NavDiagnosticsIcon"
                         Source="pack://application:,,,/Assets/nav_diagnostics.png"
                         Width="30"
                         Height="30"
                         Stretch="Uniform"
                         Margin="0,0,10,0"
                         AutomationProperties.Name="Diagnostics icon"/>
                  <TextBlock x:Name="NavDiagnosticsLabel"
                             Text="Diagnostics"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button x:Name="NavSettings"
                      Style="{StaticResource NavigationButton}"
                      Click="SettingsClick"
                      ToolTip="Preferences and Lenovo integration"
                      AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Image x:Name="NavSettingsIcon"
                         Source="pack://application:,,,/Assets/nav_settings.png"
                         Width="30"
                         Height="30"
                         Stretch="Uniform"
                         Margin="0,0,10,0"
                         AutomationProperties.Name="Settings icon"/>
                  <TextBlock x:Name="NavSettingsLabel"
                             Text="Settings"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Health card -->
            <Border x:Name="HealthCard" Style="{StaticResource Shell.HealthCard}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Text="SYSTEM HEALTH"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Ellipse x:Name="HealthDot"
                           Style="{StaticResource Status.Dot}"
                           Fill="{StaticResource Brush.TextSecondary}"/>
                  <TextBlock x:Name="HealthStatusText"
                             Text="Checking…"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HardwareStatus"
                           Style="{StaticResource Text.BodySecondary}"
                           FontSize="12"
                           Margin="0,8,0,0"
                           Text="Checking hardware provider…"/>
                <TextBlock Style="{StaticResource Text.BodySecondary}"
                           FontSize="11"
                           Margin="0,6,0,0"
                           Text="No unsafe hardware writes."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Main column -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource Shell.Header}" Margin="28,22,32,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitleText"
                       Style="{StaticResource Text.Headline}"
                       Text="Dashboard"/>
            <TextBlock x:Name="PageSubtitleText"
                       Style="{StaticResource Text.BodySecondary}"
                       Margin="0,4,0,0"
                       Text="Hardware status and live telemetry"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource Badge.Neutral}" Margin="0,0,8,0">
              <TextBlock x:Name="HeaderVersionText" Style="{StaticResource Badge.Text}" Text="v—"/>
            </Border>
            <Border x:Name="HeaderHealthBadge" Style="{StaticResource Badge.Neutral}" Margin="0,0,8,0">
              <TextBlock x:Name="HeaderHealthBadgeText" Style="{StaticResource Badge.Text}" Text="Health · Checking"/>
            </Border>
            <Border Style="{StaticResource Badge.Info}">
              <TextBlock x:Name="ProviderBadgeText" Style="{StaticResource Badge.Text}" Text="Provider · …"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource Shell.ContentHost}" x:Name="ContentHostBorder">
        <shell:PageTransitionHost x:Name="ContentHost"/>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource Shell.StatusBar}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusBarPrimary"
                     Style="{StaticResource Text.Caption}"
                     VerticalAlignment="Center"
                     Text="Ready"/>
          <TextBlock x:Name="StatusBarTelemetry"
                     Grid.Column="2"
                     Style="{StaticResource Text.Caption}"
                     VerticalAlignment="Center"
                     Margin="0,0,20,0"
                     Text="Telemetry idle"/>
          <TextBlock x:Name="StatusBarClock"
                     Grid.Column="3"
                     Style="{StaticResource Text.Caption}"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource Font.Mono}"
                     Text="—"/>
          <TextBlock x:Name="StatusBarVersion"
                     Grid.Column="0"
                     Style="{StaticResource Text.Caption}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     Margin="0,0,20,0"
                     Text="v—"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </Grid>
</Window>
