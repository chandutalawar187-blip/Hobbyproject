<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Canonical brushes -->
  <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}"/>
  <SolidColorBrush x:Key="Brush.Navigation" Color="{DynamicResource Color.Navigation}"/>
  <SolidColorBrush x:Key="Brush.Card" Color="{DynamicResource Color.Card}"/>
  <SolidColorBrush x:Key="Brush.Elevated" Color="{DynamicResource Color.Elevated}"/>
  <SolidColorBrush x:Key="Brush.Overlay" Color="{DynamicResource Color.Overlay}"/>
  <SolidColorBrush x:Key="Brush.Hover" Color="{DynamicResource Color.Hover}"/>
  <SolidColorBrush x:Key="Brush.Pressed" Color="{DynamicResource Color.Pressed}"/>

  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{DynamicResource Color.BorderSubtle}"/>
  <SolidColorBrush x:Key="Brush.FocusRing" Color="{DynamicResource Color.FocusRing}"/>

  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{DynamicResource Color.TextTertiary}"/>
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="{DynamicResource Color.TextDisabled}"/>

  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}"/>
  <SolidColorBrush x:Key="Brush.AccentOrange" Color="{DynamicResource Color.AccentOrange}"/>
  <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.Critical" Color="{DynamicResource Color.Critical}"/>
  <SolidColorBrush x:Key="Brush.Information" Color="{DynamicResource Color.Information}"/>

  <SolidColorBrush x:Key="Brush.SliderPill" Color="{DynamicResource Color.SliderPill}"/>
  <SolidColorBrush x:Key="Brush.SliderPillEdge" Color="{DynamicResource Color.SliderPillEdge}"/>
  <LinearGradientBrush x:Key="Brush.SliderPillFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{DynamicResource Color.SliderPillTop}" Offset="0"/>
    <GradientStop Color="{DynamicResource Color.SliderPillBottom}" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.SliderTrack" Color="{DynamicResource Color.SliderTrack}"/>
  <SolidColorBrush x:Key="Brush.SliderTrackMuted" Color="{DynamicResource Color.SliderTrackMuted}"/>
  <SolidColorBrush x:Key="Brush.SliderHalo" Color="{DynamicResource Color.SliderHalo}"/>
  <SolidColorBrush x:Key="Brush.SliderThumb" Color="{DynamicResource Color.SliderThumb}"/>
  <LinearGradientBrush x:Key="Brush.SliderPin" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="{DynamicResource Color.SliderPinTop}" Offset="0"/>
    <GradientStop Color="{DynamicResource Color.SliderPinBottom}" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.ThermalCool" Color="{DynamicResource Color.ThermalCool}"/>
  <SolidColorBrush x:Key="Brush.ThermalNormal" Color="{DynamicResource Color.ThermalNormal}"/>
  <SolidColorBrush x:Key="Brush.ThermalWarm" Color="{DynamicResource Color.ThermalWarm}"/>
  <SolidColorBrush x:Key="Brush.ThermalHot" Color="{DynamicResource Color.ThermalHot}"/>
  <SolidColorBrush x:Key="Brush.ThermalCritical" Color="{DynamicResource Color.ThermalCritical}"/>

  <!-- Layered background for the shell (subtle depth, not flat black) -->
  <LinearGradientBrush x:Key="Brush.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0A0D12" Offset="0"/>
    <GradientStop Color="#0C121A" Offset="0.45"/>
    <GradientStop Color="#0A1018" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.NavigationGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#121821" Offset="0"/>
    <GradientStop Color="#10151D" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.AccentSoft" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#33E2231A" Offset="0"/>
    <GradientStop Color="#00E2231A" Offset="1"/>
  </LinearGradientBrush>

  <!-- Legacy aliases used by MainWindow.xaml and UI/Views.cs — do not remove -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource Color.Background}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource Color.Card}"/>
  <SolidColorBrush x:Key="PanelAltBrush" Color="{DynamicResource Color.Elevated}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource Color.TextPrimary}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource Color.Accent}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource Color.Success}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource Color.Border}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource Color.Warning}"/>
  <SolidColorBrush x:Key="CriticalBrush" Color="{DynamicResource Color.Critical}"/>
  <SolidColorBrush x:Key="InformationBrush" Color="{DynamicResource Color.Information}"/>

</ResourceDictionary>
