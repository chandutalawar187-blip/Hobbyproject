<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design-system aggregator.
    Load order matters: colors → brushes → effects → typography → converters → controls → motion.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml"/>
    <ResourceDictionary Source="Brushes.xaml"/>
    <ResourceDictionary Source="Effects.xaml"/>
    <ResourceDictionary Source="Typography.xaml"/>
    <ResourceDictionary Source="Converters.xaml"/>
    <ResourceDictionary Source="Controls.Buttons.xaml"/>
    <ResourceDictionary Source="Controls.Cards.xaml"/>
    <ResourceDictionary Source="Controls.Navigation.xaml"/>
    <ResourceDictionary Source="Controls.Badges.xaml"/>
    <ResourceDictionary Source="Controls.Inputs.xaml"/>
    <ResourceDictionary Source="Controls.Shell.xaml"/>
    <ResourceDictionary Source="Animations.xaml"/>
  </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
