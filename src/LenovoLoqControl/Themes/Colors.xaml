<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base surfaces -->
  <Color x:Key="Color.Background">#0A0D12</Color>
  <Color x:Key="Color.Navigation">#10151D</Color>
  <Color x:Key="Color.Card">#151B24</Color>
  <Color x:Key="Color.Elevated">#1B222D</Color>
  <Color x:Key="Color.Overlay">#222A36</Color>
  <Color x:Key="Color.Hover">#252B34</Color>
  <Color x:Key="Color.Pressed">#303741</Color>

  <!-- Borders & dividers -->
  <Color x:Key="Color.Border">#2A3340</Color>
  <Color x:Key="Color.BorderSubtle">#1E2630</Color>
  <Color x:Key="Color.FocusRing">#62A8FF</Color>

  <!-- Text -->
  <Color x:Key="Color.TextPrimary">#F4F7FB</Color>
  <Color x:Key="Color.TextSecondary">#9AA8BA</Color>
  <Color x:Key="Color.TextTertiary">#6B7A8D</Color>
  <Color x:Key="Color.TextDisabled">#556273</Color>

  <!-- Accents & status -->
  <Color x:Key="Color.Accent">#E2231A</Color>
  <Color x:Key="Color.AccentHover">#F03A31</Color>
  <Color x:Key="Color.AccentOrange">#FF7043</Color>
  <Color x:Key="Color.Success">#47D18C</Color>
  <Color x:Key="Color.Warning">#F4B942</Color>
  <Color x:Key="Color.Critical">#FF4D5E</Color>
  <Color x:Key="Color.Information">#62A8FF</Color>

  <!-- Premium slider (dark glass pill + Lenovo accent track + warm value pin) -->
  <Color x:Key="Color.SliderPill">#CC1B222D</Color>
  <Color x:Key="Color.SliderPillEdge">#552A3340</Color>
  <Color x:Key="Color.SliderPillTop">#E81B222D</Color>
  <Color x:Key="Color.SliderPillBottom">#B8151B24</Color>
  <Color x:Key="Color.SliderTrack">#E2231A</Color>
  <Color x:Key="Color.SliderTrackMuted">#55E2231A</Color>
  <Color x:Key="Color.SliderHalo">#33E2231A</Color>
  <Color x:Key="Color.SliderThumb">#FFFFFF</Color>
  <Color x:Key="Color.SliderPinTop">#FFD54F</Color>
  <Color x:Key="Color.SliderPinBottom">#FF7043</Color>

  <!-- Thermal ring gradients (stops used by later components) -->
  <Color x:Key="Color.ThermalCool">#47D18C</Color>
  <Color x:Key="Color.ThermalNormal">#62A8FF</Color>
  <Color x:Key="Color.ThermalWarm">#F4B942</Color>
  <Color x:Key="Color.ThermalHot">#FF7043</Color>
  <Color x:Key="Color.ThermalCritical">#FF4D5E</Color>

</ResourceDictionary>
