<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Card.Surface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="Margin" Value="0,0,14,14"/>
    <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Card.Elevated" TargetType="Border" BasedOn="{StaticResource Card.Surface}">
    <Setter Property="Background" Value="{DynamicResource Brush.Elevated}"/>
    <Setter Property="Effect" Value="{DynamicResource ElevatedShadow}"/>
  </Style>

  <Style x:Key="Card.Metric" TargetType="Border" BasedOn="{StaticResource Card.Surface}">
    <Setter Property="MinHeight" Value="148"/>
    <Setter Property="Padding" Value="22"/>
  </Style>

  <Style x:Key="Card.Compact" TargetType="Border" BasedOn="{StaticResource Card.Surface}">
    <Setter Property="Padding" Value="16"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="MinHeight" Value="96"/>
  </Style>

  <Style x:Key="Card.Warning" TargetType="Border" BasedOn="{StaticResource Card.Surface}">
    <Setter Property="BorderBrush" Value="#6E481E"/>
    <Setter Property="Background" Value="#1A1712"/>
  </Style>

  <Style x:Key="Card.Unavailable" TargetType="Border" BasedOn="{StaticResource Card.Surface}">
    <Setter Property="Opacity" Value="0.85"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
  </Style>

  <Style x:Key="Card.SuccessBanner" TargetType="Border">
    <Setter Property="Background" Value="#16372A"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Margin" Value="0,22,0,18"/>
  </Style>

  <Style x:Key="Panel.Section" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="24"/>
    <Setter Property="Margin" Value="0,0,0,20"/>
  </Style>

</ResourceDictionary>
