<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:LenovoLoqControl.UI">

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
    <Setter Property="Margin" Value="0,12,0,0"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Box"
                    Width="20" Height="20"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                    Background="{DynamicResource Brush.Elevated}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="5">
              <Path x:Name="Check"
                    Data="M4,10 L8,14 L16,5"
                    Stroke="{DynamicResource Brush.TextPrimary}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Visibility="Collapsed"
                    Margin="1"/>
            </Border>
            <ContentPresenter Grid.Column="1"
                              Margin="10,0,0,0"
                              VerticalAlignment="Top"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Compact slider with a clear accent track and accessible thumb. -->
  <Style x:Key="Slider.RepeatTransparent" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" Height="6"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Slider.RepeatFill" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{DynamicResource Brush.SliderTrack}"
                  Height="6"
                  CornerRadius="3"
                  SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Slider.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- Compact hit target on the track; value pin floats above and does not shift the knob. -->
          <Grid Width="28" Height="24" Background="Transparent" ClipToBounds="False">
            <Grid x:Name="ValuePin"
                  Width="34" Height="34"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,-36,0,0"
                  IsHitTestVisible="False"
                  Opacity="0"
                  RenderTransformOrigin="0.5,1">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="0.72" ScaleY="0.72"/>
              </Grid.RenderTransform>
              <Path Fill="{DynamicResource Brush.SliderPin}"
                    Data="M15,33 C15,33 2,20 2,13 C2,6.4 7.4,1 15,1 C22.6,1 28,6.4 28,13 C28,20 15,33 15,33 Z"
                    Stretch="Fill"
                    Width="32" Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Path.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                    Opacity="0.35" Color="#FF7043"/>
                </Path.Effect>
              </Path>
              <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}"
                         Foreground="White"
                         FontWeight="Bold"
                         FontSize="10"
                         FontFamily="{DynamicResource Font.UI}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,7,0,0"/>
            </Grid>

            <Grid Width="24" Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <Ellipse x:Name="Halo"
                       Width="24" Height="24"
                       Fill="{DynamicResource Brush.SliderHalo}"
                       Opacity="0"/>
              <Ellipse x:Name="Knob"
                       Width="14" Height="14"
                       Fill="{DynamicResource Brush.SliderThumb}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.35" Color="#FFFFFF"/>
                </Ellipse.Effect>
              </Ellipse>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.5"/>
              <Setter TargetName="Halo" Property="Width" Value="24"/>
              <Setter TargetName="Halo" Property="Height" Value="24"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.7"/>
              <Setter TargetName="Knob" Property="Width" Value="16"/>
              <Setter TargetName="Knob" Property="Height" Value="16"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ValuePin"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ValuePin"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ValuePin"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ValuePin"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ValuePin"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.72" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ValuePin"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.72" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="Slider.HorizontalTemplate" TargetType="Slider">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TickBar x:Name="TopTick"
               Grid.Row="0"
               Opacity="0"
               Height="0"
               Placement="Top"
               Fill="{DynamicResource Brush.SliderTrack}"/>

      <Grid Grid.Row="1"
            MinWidth="120"
            VerticalAlignment="Center"
            Margin="0,0,0,0">
        <Grid VerticalAlignment="Center">
          <!-- Inactive track -->
          <Border Height="6"
                  CornerRadius="3"
                  Background="{DynamicResource Brush.SliderTrackMuted}"
                  VerticalAlignment="Center"/>

          <Track x:Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}"
                 Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                 VerticalAlignment="Center">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource Slider.RepeatFill}"
                            Command="Slider.DecreaseLarge"/>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource Slider.Thumb}"/>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource Slider.RepeatTransparent}"
                            Command="Slider.IncreaseLarge"/>
            </Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </Grid>

      <TickBar x:Name="BottomTick"
               Grid.Row="2"
               Opacity="0"
               Height="0"
               Placement="Bottom"
               Fill="{DynamicResource Brush.SliderTrackMuted}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TickPlacement" Value="TopLeft">
        <Setter TargetName="TopTick" Property="Height" Value="4"/>
        <Setter TargetName="TopTick" Property="Opacity" Value="0.55"/>
        <Setter TargetName="TopTick" Property="Margin" Value="14,0,14,4"/>
      </Trigger>
      <Trigger Property="TickPlacement" Value="BottomRight">
        <Setter TargetName="BottomTick" Property="Height" Value="4"/>
        <Setter TargetName="BottomTick" Property="Opacity" Value="0.55"/>
        <Setter TargetName="BottomTick" Property="Margin" Value="14,4,14,0"/>
      </Trigger>
      <Trigger Property="TickPlacement" Value="Both">
        <Setter TargetName="TopTick" Property="Height" Value="4"/>
        <Setter TargetName="TopTick" Property="Opacity" Value="0.55"/>
        <Setter TargetName="BottomTick" Property="Height" Value="4"/>
        <Setter TargetName="BottomTick" Property="Opacity" Value="0.55"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="#E2231A"/>
          </Setter.Value>
        </Setter>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="Slider">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.SliderTrack}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.SliderPill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SliderPillEdge}"/>
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template" Value="{StaticResource Slider.HorizontalTemplate}"/>
    <Setter Property="ui:ElasticSlider.IsEnabled" Value="True"/>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CanContentScroll" Value="False"/>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Elevated}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Default}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <ContentPresenter Margin="0,0,28,0"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Path HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      Data="M0,0 L5,5 L10,0"
                      Stroke="{DynamicResource Brush.TextSecondary}"
                      StrokeThickness="1.5"/>
              </Grid>
            </Border>
            <ToggleButton Background="Transparent"
                          BorderThickness="0"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
              <Border Background="{DynamicResource Brush.Elevated}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1"
                      CornerRadius="7"
                      Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="320">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Elevated}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinHeight" Value="32"/>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Setting.Row" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0,10"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <Style x:Key="ToolTip.Standard" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.Elevated}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
    <Setter Property="HasDropShadow" Value="True"/>
  </Style>

  <Style TargetType="ToolTip" BasedOn="{StaticResource ToolTip.Standard}"/>

</ResourceDictionary>
