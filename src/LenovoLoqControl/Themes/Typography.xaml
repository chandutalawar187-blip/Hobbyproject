<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Prefer Segoe UI Variable on Windows 11; Segoe UI remains the reliable fallback. -->
  <FontFamily x:Key="Font.UI">Segoe UI Variable, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <sys:Double x:Key="FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.BodyLarge">15</sys:Double>
  <sys:Double x:Key="FontSize.Subtitle">17</sys:Double>
  <sys:Double x:Key="FontSize.Title">22</sys:Double>
  <sys:Double x:Key="FontSize.Headline">28</sys:Double>
  <sys:Double x:Key="FontSize.Display">34</sys:Double>
  <sys:Double x:Key="FontSize.Metric">36</sys:Double>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>

  <Style x:Key="Text.BodySecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Text.Headline" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Headline}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Metric}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
  </Style>

  <Style x:Key="Text.BrandMark" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
    <Setter Property="FontSize" Value="32"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>

</ResourceDictionary>
