<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AssemblyName>LoqControl</AssemblyName>
    <RootNamespace>LenovoLoqControl</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <Version>1.0.9</Version>
    <AssemblyVersion>1.0.9.0</AssemblyVersion>
    <FileVersion>1.0.9.0</FileVersion>
    <InformationalVersion>1.0.9</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LottieSharp" Version="2.4.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
  </ItemGroup>
  <ItemGroup>
    <!-- Extracted from .lottie packages for LottieSharp (JSON + image assets). -->
    <Content Include="Assets\GpuIsometric.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\RgbCircle.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Task.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\TaskNav.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Laptop_Control_Center.lottie">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\i\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\GpuIsometric.json" />
    <Resource Include="Assets\RgbCircle.json" />
    <Resource Include="Assets\Task.json" />
    <None Include="Assets\GpuIsometric.lottie" />
    <None Include="Assets\RgbCircle.lottie" />
    <None Include="Assets\Task.lottie" />
    <None Include="Assets\TaskNavPreview.png" />
  </ItemGroup>
</Project>
