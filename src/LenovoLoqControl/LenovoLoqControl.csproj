<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AssemblyName>LoqControl</AssemblyName>
    <RootNamespace>LenovoLoqControl</RootNamespace>
    <AssemblyTitle>LOQ Control</AssemblyTitle>
    <Product>LOQ Control</Product>
    <Company>LOQ Control</Company>
    <Description>Native Lenovo LOQ monitoring and control center</Description>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app_icon_black.ico</ApplicationIcon>
    <Version>1.2.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <InformationalVersion>1.2.2</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="ThirdParty\LibreHardwareMonitor\LICENSE-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>ThirdParty\LibreHardwareMonitor\LICENSE-NOTICE.txt</TargetPath>
    </Content>
    <None Include="Assets\app_icon.png" />
    <PackageReference Include="LottieSharp" Version="2.4.3" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Extracted from .lottie packages for LottieSharp (JSON + image assets). -->
    <Content Include="Assets\GpuIsometric.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\RgbCircle.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Task.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\TaskNav.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Laptop_Control_Center.lottie">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\i\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\GpuIsometric.json" />
    <Resource Include="Assets\RgbCircle.json" />
    <Resource Include="Assets\Task.json" />
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_icon_black.ico" />
    <Resource Include="Assets\app_icon_black.png" />
    <Resource Include="Assets\notification_icon.png" />
    <Resource Include="Assets\nav_dashboard.png" />
    <Resource Include="Assets\nav_fan.png" />
    <Resource Include="Assets\nav_lighting.png" />
    <Resource Include="Assets\nav_profiles.png" />
    <Resource Include="Assets\nav_projects.png" />
    <Resource Include="Assets\nav_diagnostics.png" />
    <Resource Include="Assets\nav_settings.png" />
    <Resource Include="Assets\caption_close.png" />
    <Resource Include="Assets\caption_maximize.png" />
    <Resource Include="Assets\caption_restore.png" />
    <Resource Include="Assets\caption_minimize.png" />
    <None Include="Assets\GpuIsometric.lottie" />
    <None Include="Assets\RgbCircle.lottie" />
    <None Include="Assets\Task.lottie" />
    <None Include="Assets\TaskNavPreview.png" />
  </ItemGroup>
</Project>
